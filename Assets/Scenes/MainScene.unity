  m_Text: "\uC2A4\uD14C\uC774\uC9C0 1\uACFC 2\uC5D0\uC11C\uB294 \uC911\uB825 \uC2DC\uC2A4\uD15C
    \uB355\uBD84\uC5D0\n\uCE90\uB9AD\uD130\uAC00 \uC9C0\uBA74\uC5D0 \uBD99\uC5B4
    \uC6C0\uC9C1\uC785\uB2C8\uB2E4.\n\n\uD558\uC9C0\uB9CC \uC2A4\uD14C\uC774\uC9C0
    3\uC5D0\uC11C \uBCF4\uC2A4\uAC00 \uC911\uB825 \uC7A5\uCE58\uB97C \uD30C\uAD34\uD558\uBA70,\n\uBB34\uC911\uB825
    \uC0C1\uD0DC\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4.\n\n\uC774\uB54C\uBD80\uD130
    \uCE90\uB9AD\uD130\uB294 \uACF5\uC911\uC5D0 \uB5A0 \uC788\uAC8C \uB418\uBA70,\n\uBC29\uD5A5\uD0A4
    \uC704/\uC544\uB798\uB85C \uC9C1\uC811 \uC81C\uC5B4\uD574\uC57C \uD569\uB2C8\uB2E4."
